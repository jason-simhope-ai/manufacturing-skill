# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# ---------------------------------------------------------------------
# Real factory data — NEVER commit. Best practice: keep these in a working
# folder OUTSIDE this repo (e.g. ~/factory-work/); these rules are a safety net.
# See docs/adoption-guide.md and docs/data-classification.md.
# ---------------------------------------------------------------------
company-facts.md
customer-data/
drawings/
rfq/
logs/
*.dwg
*.step
*.stp
*.iges
# Synthetic demo data under examples/ stays tracked (must stay below the
# rules above and above the secrets / examples "real_*" rules that follow).
!examples/**

# Local secrets — never commit
.env
.env.local
.env.*.local
**/secrets/
**/credentials/

# Real customer data — keep examples/ synthetic only
examples/**/real_*
examples/**/*_real.*
examples/**/customer_*

# Local LLM runtime artifacts
infra/on-prem/models/
infra/on-prem/cache/

# MCP server runtime data
infra/mcp-servers/**/data/
infra/mcp-servers/**/logs/

# Claude Code local session state — entire .claude/ is local-only
# (the plugin is installed to ~/.claude/plugins/manufacturing-plugin/, not here)
.claude/

# Build artifacts
dist/
build/
*.log

# Digital twin team tier (spec 2026-10-05-digital-twin-team-design.md §4).
# The parent must be `team/local/*` (not `team/local/`) so the negations work.
team/local/*
!team/local/README.md
!team/local/.gitkeep
team/.build/
*.local.yaml
*.local.md
logs/
**/audit/
**/memory/

# Exports and de-identified exports belong OUTSIDE the clone (/tmp or $MFG_TEAM_DATA_T1; see
# team/local/README.md). Belt and braces in case one lands here anyway. examples/** stays tracked.
*.deid.csv
team/local/**/*.csv
# Stricter, optional: ignore every CSV in the clone but keep the synthetic examples tracked.
# *.csv
# !examples/**/*.csv

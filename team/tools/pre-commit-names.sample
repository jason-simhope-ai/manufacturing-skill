#!/usr/bin/env bash
# Sample git pre-commit hook: block commits whose staged additions match the
# local name denylist. Install:
#   cp team/tools/pre-commit-names.sample .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
# The denylist (real names, customer names, project codes, one regex per line)
# lives in team/local/names.denylist, which is gitignored. Public CI cannot see
# that list, so this hook is the real defence against real names (spec 11.4).
set -u
root="$(git rev-parse --show-toplevel)"
list="${root}/team/local/names.denylist"
if [ ! -f "${list}" ]; then
  echo "pre-commit-names: ${list} not found; skipping name scan" >&2
  exit 0
fi
pats="$(mktemp)"
trap 'rm -f "${pats}"' EXIT
grep -v -E '^[[:space:]]*(#|$)' "${list}" > "${pats}" || true
if [ ! -s "${pats}" ]; then
  exit 0
fi
hits="$(git diff --cached -U0 --no-color | grep -E '^\+[^+]' | grep -n -E -f "${pats}" || true)"
if [ -n "${hits}" ]; then
  echo "pre-commit-names: staged changes match team/local/names.denylist:" >&2
  echo "${hits}" | cut -c1-80 >&2
  echo "Remove the names (use CUST-EX-001 / PN-EX-0001 style placeholders)." >&2
  exit 1
fi
exit 0
